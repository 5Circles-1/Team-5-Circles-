# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon key are safe for the browser; the service-role key is not.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Mail (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
MAIL_FROM="5C Pulse <pulse@yourdomain.com>"

# ── Cron ────────────────────────────────────────────────────────────────────
# Vercel Cron sends this as a Bearer token; the cron routes refuse anything else.
CRON_SECRET=generate-a-long-random-string

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
